% Generated by hand to match roxygen comments in R/ols.R.
\name{compute_ols_mi}
\alias{compute_ols_mi}
\alias{permutation_test_ols}
\alias{run_PathMI_OLS}
\title{PathMI: OLS-based DOE mutual information estimator}
\usage{
compute_ols_mi(Z, y)

permutation_test_ols(Z, y, B = 500, seed = 42)

run_PathMI_OLS(embedding_list, targets, agg_method = "mean", B = 500,
               fdr_alpha = 0.05, seed = 42)
}
\arguments{
\item{Z}{A patients x features numeric matrix, with \code{ncol(Z) < nrow(Z)}.}

\item{y}{Response vector (may be binary 0/1, treated as continuous).}

\item{B}{Number of permutations.}

\item{seed}{Random seed.}

\item{embedding_list}{Named list of per-patient tile x feature matrices.}

\item{targets}{Named list of binary (0/1) target vectors, one per molecular
outcome, each named by patient ID.}

\item{agg_method}{Tile-aggregation method, \code{"mean"} or \code{"median"}.}

\item{fdr_alpha}{Significance threshold applied to BH-adjusted p-values.}
}
\value{
\code{compute_ols_mi} returns a list with \code{MI} (nats), \code{R2},
\code{sigma2_null}, \code{sigma2_fit}, \code{n_features}, and \code{fit}.

\code{permutation_test_ols} returns a list with \code{MI_observed},
\code{MI_null}, and \code{pvalue}.

\code{run_PathMI_OLS} returns a list with \code{summary} (data frame of MI,
p-value, and BH q-value per target) and \code{raw} (full per-target results).
}
\description{
\code{compute_ols_mi} fits \code{y} on all columns of \code{Z} via OLS and
estimates mutual information as the Gaussian channel-capacity formula
\eqn{0.5 \log(\sigma^2_{null} / \sigma^2_{fit})}, exact for Gaussian
\code{y} and an approximation for binary \code{y} (linear probability
model). Only appropriate when the number of features is much smaller than
the number of patients; use the LASSO estimator otherwise.

\code{permutation_test_ols} builds a null distribution for the observed MI
by refitting on shuffled labels.

\code{run_PathMI_OLS} runs the OLS pipeline across multiple targets with
Benjamini-Hochberg FDR correction.
}
