% Generated by hand to match roxygen comments in R/subho.R.
\name{plot_MI_null}
\alias{plot_MI_null}
\alias{plot_likelihood_surface}
\alias{v_beta_sensitivity}
\alias{plot_v_beta_sensitivity}
\title{Diagnostics for the logistic SUBHO pipeline}
\usage{
plot_MI_null(result.obj, target.name)

plot_likelihood_surface(result.obj, target.name)

v_beta_sensitivity(Z, y, v_beta.grid = c(1, 5, 10, 25, 100),
                    method.weight = "beta.binomial",
                    nmc = 2000, burn = 200, thin = 10, verbose = TRUE)

plot_v_beta_sensitivity(sens.df)
}
\arguments{
\item{result.obj}{Output of \code{\link{pathMI_pipeline}}.}

\item{target.name}{Name of the target (as used in \code{targets}) to plot.}

\item{Z}{A patients x features numeric matrix.}

\item{y}{Binary (0/1) response vector.}

\item{v_beta.grid}{Numeric vector of \code{v_beta} values to sweep.}

\item{method.weight}{Model-space prior over subset size.}

\item{nmc, burn, thin}{MCMC settings for the horseshoe sampler.}

\item{verbose}{Print progress.}

\item{sens.df}{Output of \code{v_beta_sensitivity}.}
}
\value{
\code{plot_MI_null} and \code{plot_likelihood_surface} are called for their
plotting side effect.

\code{v_beta_sensitivity} returns a data frame with one row per
\code{v_beta.grid} value: \code{v_beta}, \code{MI}, \code{MI_raw},
\code{n.selected}, \code{cond.H.best}.

\code{plot_v_beta_sensitivity} is called for its plotting side effect.
}
\description{
\code{plot_MI_null} plots the permutation null distribution for one target
against the observed MI.

\code{plot_likelihood_surface} plots the SUBHO log marginal likelihood +
log prior surface across the feature walk for one target.

\code{v_beta_sensitivity} reruns \code{\link{subho_MI_logistic}} across a
grid of coefficient prior variances on the same data, since model
selection and the resulting MI estimate can both shift with \code{v_beta}.

\code{plot_v_beta_sensitivity} plots the results of a sensitivity sweep.
}
