% Generated by hand to match roxygen comments in R/lasso.R.
\name{run_lasso_cv}
\alias{run_lasso_cv}
\alias{compute_doe_mi}
\alias{permutation_test_lasso}
\alias{run_PathMI_LASSO}
\alias{plot_cv_lasso}
\title{PathMI: LASSO-CV DOE mutual information estimator}
\usage{
run_lasso_cv(Z, y, nfolds = 10, seed = 42)

compute_doe_mi(Z, y, lasso_result)

permutation_test_lasso(Z, y, nfolds = 10, B = 500, seed = 42)

run_PathMI_LASSO(embedding_list, targets, nfolds = 10, B = 500,
                 agg_method = "mean", fdr_alpha = 0.05, seed = 42)

plot_cv_lasso(lasso_result, title = "LASSO CV")
}
\arguments{
\item{Z}{A patients x features numeric matrix (e.g. from \code{\link{aggregate_embeddings}}).}

\item{y}{Binary (0/1) response vector.}

\item{nfolds}{Number of cross-validation folds.}

\item{seed}{Random seed.}

\item{lasso_result}{Output of \code{run_lasso_cv}.}

\item{B}{Number of permutations.}

\item{embedding_list}{Named list of per-patient tile x feature matrices.}

\item{targets}{Named list of binary (0/1) target vectors, one per molecular
outcome, each named by patient ID.}

\item{agg_method}{Tile-aggregation method, \code{"mean"} or \code{"median"}.}

\item{fdr_alpha}{Significance threshold applied to BH-adjusted p-values.}

\item{title}{Plot title.}
}
\value{
\code{run_lasso_cv} returns a list with \code{selected_features}
(indices of nonzero coefficients at \code{lambda.min}), \code{coef_lasso},
\code{lambda_min}, and \code{cv_fit}.

\code{compute_doe_mi} returns a list with \code{MI}, \code{ll_fitted},
\code{ll_null}, and \code{n_selected}.

\code{permutation_test_lasso} returns a list with \code{MI_observed},
\code{MI_null}, \code{pvalue}, and \code{lasso_result}.

\code{run_PathMI_LASSO} returns a list with \code{summary} (data frame of
MI, p-value, and BH q-value per target) and \code{raw} (full per-target
results).

\code{plot_cv_lasso} is called for its plotting side effect.
}
\description{
\code{run_lasso_cv} fits an L1-penalized logistic regression of \code{y} on
\code{Z} via \code{\link[glmnet]{cv.glmnet}}, selecting the model at
\code{lambda.min}.

\code{compute_doe_mi} estimates mutual information as the log-likelihood
ratio between the fitted LASSO model and the null (intercept-only) model.

\code{permutation_test_lasso} shuffles \code{y} \code{B} times, refitting
the full LASSO-CV + MI pipeline each time, to build a null distribution.

\code{run_PathMI_LASSO} runs the LASSO pipeline across multiple targets
with Benjamini-Hochberg FDR correction.

\code{plot_cv_lasso} plots the cross-validation deviance curve for a fit.
}
