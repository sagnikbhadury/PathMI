% Generated by hand to match roxygen comments in R/subho.R.
\name{subho_MI_logistic}
\alias{subho_MI_logistic}
\alias{permutation_test_logistic}
\alias{pathMI_pipeline}
\title{PathMI: logistic SUBHO (Polya-Gamma horseshoe) mutual information estimator}
\usage{
subho_MI_logistic(Z, y, v_beta = 1, method.weight = "beta.binomial",
                   nmc = 2000, burn = 200, thin = 10)

permutation_test_logistic(Z, y, n.perm = 500, v_beta = 1,
                           method.weight = "beta.binomial",
                           nmc = 2000, burn = 200, thin = 10,
                           seed = 42, verbose = TRUE)

pathMI_pipeline(embedding_list, targets, n.perm = 500, v_beta = 1,
                 method.weight = "beta.binomial", agg.method = "mean",
                 nmc = 2000, burn = 200, thin = 10, fdr.method = "BH",
                 seed = 42, verbose = TRUE)
}
\arguments{
\item{Z}{A patients x features numeric matrix.}

\item{y}{Binary (0/1) response vector.}

\item{v_beta}{Prior variance on the regression coefficients.}

\item{method.weight}{Model-space prior over subset size:
\code{"beta.binomial"} (default) or \code{"basic.binomial"}.}

\item{nmc, burn, thin}{MCMC settings for the horseshoe sampler.}

\item{n.perm}{Number of permutations.}

\item{seed}{Random seed.}

\item{verbose}{Print progress.}

\item{embedding_list}{Named list of per-patient tile x feature matrices.}

\item{targets}{Named list of binary (0/1) target vectors, one per molecular
outcome, each named by patient ID.}

\item{agg.method}{Tile-aggregation method, \code{"mean"} or \code{"median"}.}

\item{fdr.method}{Method passed to \code{\link[stats]{p.adjust}}.}
}
\value{
\code{subho_MI_logistic} returns a list with \code{MI} (floored at 0),
\code{MI.raw} (pre-floor estimate), \code{cond.H.best}, \code{cond.H.null},
\code{n.selected}, \code{selected.features}, \code{BetaHat},
\code{Sp.BetaHat}, \code{LogLikelihood}, and \code{pseudo.pval}.

\code{permutation_test_logistic} returns a numeric vector of null MI values.

\code{pathMI_pipeline} returns a list with \code{summary} (data frame of MI,
raw MI, Hessian condition number, permutation p-value, and BH q-value per
target), \code{details} (full per-target results), and \code{Z_scaled}.
}
\description{
\code{subho_MI_logistic} fits the Polya-Gamma logistic horseshoe model and
runs the SUBHO marginal-likelihood feature walk to select the
best-supported subset, then estimates mutual information as the per-sample
log Bayes factor of the best model versus the null model.

\code{permutation_test_logistic} builds a null distribution for the
observed MI by refitting the full pipeline on shuffled labels.

\code{pathMI_pipeline} runs the logistic SUBHO pipeline across multiple
targets with Benjamini-Hochberg FDR correction.
}
\examples{
\dontrun{
result_crc <- pathMI_pipeline(
  embedding_list = embedding_list_crc,
  targets = list(MSI = setNames(msi_df$status, msi_df$patient_id)),
  n.perm = 500, v_beta = 1, method.weight = "beta.binomial"
)
plot_MI_null(result_crc, "MSI")
plot_likelihood_surface(result_crc, "MSI")
}
}
